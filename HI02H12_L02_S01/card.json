  "audio_text": {
   "vo_celebrate": "बहुत बढ़िया, दोस्त! तुमने कमाल कर दिया!",
   "vo_g1_c": "शाबाश! सही वाक्य है— यह एक सुंदर बगीचा है।",
   "vo_g1_prompt": "दिए गए चित्र के लिए वाक्य बनाइए। देखिए, कौन-सा शब्द वाक्य के लिए सही है।",
   "vo_g1_stem": "यह एक … बगीचा है।",
   "vo_g2_c": "शाबाश! सही वाक्य है— कुत्ता गेंद से खेल रहा है।",
   "vo_g2_prompt": "चित्र देखकर वाक्य बनाइए।",
   "vo_g2_s": "कुत्ता गेंद से खेल रहा है।",
   "vo_g3_c": "शाबाश! सही वाक्य है— पेड़ पर सेब लगे हैं।",
   "vo_g3_prompt": "चित्र देखकर वाक्य बनाइए।",
   "vo_g3_s": "पेड़ पर सेब लगे हैं।",
   "vo_g4_c": "शाबाश! सही वाक्य है— गाय घास खा रही है।",
   "vo_g4_prompt": "चित्र देखकर वाक्य बनाइए।",
   "vo_g4_s": "गाय घास खा रही है।",
   "vo_landing": "नमस्ते दोस्त, मैं हूँ स्विफ्टी। आज हम शब्दों से वाक्य बनाना सीखेंगे।",
   "vo_p1_c": "शाबाश! सही वाक्य है— मीरा पौधों को पानी दे रही है।",
   "vo_p1_prompt": "आइए, दिए गए चित्र के लिए वाक्य बनाते हैं।",
   "vo_p1_stem": "मीरा पौधों को … दे रही है।",
   "vo_p2_c": "शाबाश! सही वाक्य है— बिल्ली टोकरी में सो रही है।",
   "vo_p2_prompt": "आइए, दिए गए चित्र के लिए वाक्य बनाते हैं।",
   "vo_p2_stem": "बिल्ली टोकरी में … है।",
   "vo_p3_c": "शाबाश! सही वाक्य है— बच्चा प्यासा है, उसे पानी चाहिए।",
   "vo_p3_prompt": "सही शब्द चुनकर वाक्य बनाइए।",
   "vo_p3_stem": "बच्चा प्यासा है, उसे … चाहिए।",
   "vo_p4_c": "शाबाश! सही वाक्य है— रात के समय आसमान में तारे चमकते हैं।",
   "vo_p4_prompt": "सही शब्द चुनकर वाक्य बनाइए।",
   "vo_p4_stem": "रात के समय आसमान में … चमकते हैं।",
   "vo_p5_c": "शाबाश! सही वाक्य है— लड़की गाना गा रही है।",
   "vo_p5_prompt": "चित्र देखकर वाक्य बनाइए।",
   "vo_p5_s": "लड़की गाना गा रही है।",
   "vo_p6_c": "शाबाश! सही वाक्य है— बकरी पत्ते खा रही है।",
   "vo_p6_prompt": "चित्र देखकर वाक्य बनाइए।",
   "vo_p6_s": "बकरी पत्ते खा रही है।",
   "vo_pt_guided": "चलिए, साथ में करें।",
   "vo_pt_practice": "वाह! अब आपकी बारी।",
   "vo_pt_tutorial": "चलिए, शुरू करें!",
   "vo_reveal": "सही शब्द चमक रहा है, उस पर टैप कीजिए।",
   "vo_sahi": "सही वाक्य है—",
   "vo_shabash_sahi": "शाबाश! सही वाक्य है—",
   "vo_t1_c": "सही वाक्य है— आसमान में चिड़िया उड़ रही है।",
   "vo_t1_o_chidiya": "आसमान में चिड़िया उड़ रही है।",
   "vo_t1_o_gaadi": "आसमान में गाड़ी उड़ रही है।",
   "vo_t1_o_machhli": "आसमान में मछली उड़ रही है।",
   "vo_t1_prompt": "आइए, दिए गए चित्र के लिए वाक्य बनाते हैं। ध्यान से देखिए, चित्र में क्या हो रहा है? चित्र में एक चिड़िया आसमान में उड़ रही है। आइए देखते हैं, कौन-सा वाक्य चित्र के लिए सही है।",
   "vo_t1_stem": "आसमान में … उड़ रही है।",
   "vo_t2_prompt": "आइए, दिए गए चित्र के लिए वाक्य बनाते हैं। ध्यान से देखिए, चित्र में क्या हो रहा है? चित्र में बच्चे मैदान में खेल रहे हैं। इसलिए हम वाक्य बनाएंगे—",
   "vo_t2_s": "बच्चे मैदान में खेल रहे हैं।",
   "vo_t3_prompt": "आइए, दिए गए चित्र के लिए वाक्य बनाते हैं। ध्यान से देखिए, चित्र में क्या हो रहा है? चित्र में एक लड़की किताब पढ़ रही है। इसलिए हम वाक्य बनाएंगे—",
   "vo_t3_s": "लड़की किताब पढ़ रही है।",
   "vo_try_again": "फिर से कोशिश कीजिए।",
